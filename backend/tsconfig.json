{
  // Visit https://aka.ms/tsconfig to read mode about this file
  "compilerOptions": {

    "rootDir": "./src",
    "outDir": "./dist",


    "module": "esnext",
    "target": "ES2022",
    "types": ["node"],
    "lib": ["ES2022"],
    "esModuleInterop": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
  
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  }
}
