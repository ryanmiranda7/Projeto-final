PORT=3333
OPENAI_API_KEY=

# String de conexão do PostgreSQL.
# Se estiver usando o docker-compose.yml da raiz do projeto, o valor
# abaixo já funciona sem alterações.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dietas?schema=public"

# Envio do PDF da dieta por email (opcional — sem isto configurado, o
# botão "Enviar por email" mostra um erro claro em vez de falhar em
# silêncio). Funciona com qualquer SMTP: Gmail (usar uma "app password",
# não a palavra-passe normal da conta), Outlook, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opcional — por omissão usa SMTP_USER como remetente.
SMTP_FROM=
